{
  "name": "air-finance-monorepo",
  "version": "1.0.1",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "yarn workspace @air-finance/web dev",
    "dev:mobile": "yarn workspace @air-finance/mobile-webview start:tunnel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"apps\" \"packages\" \"package.json\"",
    "format:check": "prettier --check \"apps\" \"packages\" \"package.json\"",
    "typecheck": "turbo run type-check",
    "test": "yarn test:web",
    "test:web": "yarn workspace @air-finance/web test:run",
    "test:web:watch": "yarn workspace @air-finance/web test",
    "test:web:coverage": "yarn workspace @air-finance/web test:coverage",
    "clean": "turbo run clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "turbo": "^2.8.20"
  },
  "resolutions": {
    "undici": "6.24.1",
    "tar": "7.5.22",
    "axios": "1.18.1",
    "form-data": "4.0.6",
    "flatted": "3.4.2",
    "lodash": "4.18.1",
    "@xmldom/xmldom": "0.8.13",
    "ajv": "6.14.0",
    "@react-native/codegen": "0.84.1",
    "chromium-edge-launcher": "0.3.0",
    "test-exclude": "7.0.2",
    "node-forge": "1.4.0",
    "brace-expansion": "5.0.9",
    "minimatch@npm:3.1.5": "patch:minimatch@npm%3A3.1.5#~/.yarn/patches/minimatch-npm-3.1.5-86958baf50.patch",
    "minimatch@npm:^3.1.5": "patch:minimatch@npm%3A3.1.5#~/.yarn/patches/minimatch-npm-3.1.5-86958baf50.patch",
    "minimatch@npm:^3.1.2": "patch:minimatch@npm%3A3.1.5#~/.yarn/patches/minimatch-npm-3.1.5-86958baf50.patch",
    "minimatch@npm:^3.0.4": "patch:minimatch@npm%3A3.1.5#~/.yarn/patches/minimatch-npm-3.1.5-86958baf50.patch",
    "picomatch@npm:^2.0.4": "npm:2.3.2",
    "picomatch@npm:^2.2.1": "npm:2.3.2",
    "picomatch@npm:^2.2.3": "npm:2.3.2",
    "picomatch@npm:^2.3.1": "npm:2.3.2",
    "picomatch@npm:^4.0.2": "npm:4.0.4",
    "picomatch@npm:^4.0.3": "npm:4.0.4",
    "yaml": "2.8.3",
    "follow-redirects": "1.16.0",
    "js-yaml": "4.3.0",
    "shell-quote": "1.10.0",
    "ws@npm:^7.5.10": "npm:7.5.11",
    "ws@npm:^7": "npm:7.5.11",
    "ws@npm:^8.12.1": "npm:8.21.0",
    "ws@npm:^8.18.0": "npm:8.21.0",
    "postcss": "8.5.25",
    "ip-address": "10.4.0",
    "image-size": "1.2.1",
    "@babel/core": "7.29.6",
    "uuid@npm:^7.0.3": "npm:11.1.1",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2"
  },
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=24.x"
  }
}
